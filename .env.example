APP_NAME=Tracking
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=https://tracking.test
ASSET_URL=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Standard local runtime uses Herd-managed MySQL.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tracking
DB_USERNAME=root
DB_PASSWORD=
DB_FOREIGN_KEYS=true

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=null

BROADCAST_CONNECTION=log
CACHE_STORE=database
CACHE_PREFIX=
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_EHLO_DOMAIN=tracking.test
MAIL_FROM_ADDRESS="tracking@example.test"
MAIL_FROM_NAME="${APP_NAME}"

# Azure OAuth is the normal login path for the web UI.
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_REDIRECT_URI="${APP_URL}/oauth/azure/callback"
AZURE_TENANT_ID=
PROXY=

# The active OAuth gate checks the allowed_domains table. These config values
# are reserved for supplemental allowlist behavior if the app wires them in.
VALID_LOGIN_DOMAINS=prologuetechnology.com
VALID_LOGIN_USERS=

# Pipeline powers the live shipment lookup surfaces.
PIPELINE_BASE_URL=
PIPELINE_API_URL=
PIPELINE_API_KEY=

# Fresh local machines should usually use the public disk until Spaces access
# is available. If you change this to public, also run:
# herd php artisan storage:link
IMAGE_UPLOAD_DISK=public

# Optional DigitalOcean Spaces configuration for image uploads.
DIGITALOCEAN_SPACES_KEY=
DIGITALOCEAN_SPACES_SECRET=
DIGITALOCEAN_SPACES_ENDPOINT=
DIGITALOCEAN_SPACES_REGION=
DIGITALOCEAN_SPACES_BUCKET=

# Optional compatibility settings for the generic s3 disk and related services.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Optional mail and notification providers.
POSTMARK_TOKEN=
RESEND_KEY=
SLACK_BOT_USER_OAUTH_TOKEN=
SLACK_BOT_USER_DEFAULT_CHANNEL=

VITE_APP_NAME="${APP_NAME}"
